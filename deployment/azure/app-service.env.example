# Future Azure SQL cutover template. SQLite remains the application default unless
# DLS_DATABASE_TYPE=azure-sql and a valid connection string are deliberately configured.
# Copy values into Azure App Service settings; do not store real secrets in this file.

DLS_ENVIRONMENT=production
DLS_DATABASE_TYPE=azure-sql
DLS_DATABASE_CONNECTION_STRING=Driver={ODBC Driver 18 for SQL Server};Server=tcp:YOUR-SERVER.database.windows.net,1433;Database=YOUR-DATABASE;Encrypt=yes;TrustServerCertificate=no;Connection Timeout=30;Authentication=ActiveDirectoryMsi;
DLS_DATABASE_TIMEOUT_SECONDS=30
DLS_DATABASE_AUTO_SCHEMA=1
DLS_HOST=0.0.0.0
PORT=8000
WEBSITES_PORT=8000
DLS_BASE_URL=https://YOUR-APP.azurewebsites.net/
DLS_AUTH_MODE=local
DLS_SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
DLS_DEFAULT_ADMIN_USERNAME=admin
DLS_DEFAULT_ADMIN_PASSWORD=REPLACE_BEFORE_FIRST_DEPLOYMENT
DLS_DAILY_IMPORT_ENABLED=0

# Microsoft Graph email. The Azure App Service managed identity should receive
# the Exchange Online Application Mail.Send role scoped to BarefootNC.Glass@bldr.com.
# No mailbox password or client secret is required in Azure.
DLS_EMAIL_TRANSPORT=graph
DLS_GRAPH_AUTH_MODE=managed-identity
DLS_GRAPH_SENDER=BarefootNC.Glass@bldr.com
DLS_EMAIL_FROM=BarefootNC.Glass@bldr.com
DLS_EMAIL_TEST_RECIPIENT=brandon.m.smith@bldr.com
DLS_GRAPH_SAVE_TO_SENT_ITEMS=1
# Optional only for a user-assigned managed identity:
# DLS_GRAPH_MANAGED_IDENTITY_CLIENT_ID=
