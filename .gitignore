# File: .gitignore
# Virtual environments
.venv/
venv/
env/

# Python cache/files
__pycache__/
*.pyc
*.pyo
*.pyd

# Temporary/project-generated folders
Temp/
Temp Delivery Lists/
Backups/
_verification/
tmp*/

# Generated export/build files
*.tar.gz
*.zip
*.log
*.tmp
data/production-file-index.json

# SQLite runtime sidecars
*.db-wal
*.db-shm

# Excel temporary/lock files
~$*.xlsm
~$*.xlsx
~$*.xls
*.xlk

# Local editor/system files
.vscode/
.DS_Store
Thumbs.db
desktop.ini
